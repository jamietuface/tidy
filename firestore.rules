rules_version = '2';

// Tidy — Firestore security rules
//
// Core rule: a user can only read or write documents within their own
// /users/{uid}/... subtree. Anonymous users get the same isolation by uid.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthed() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthed() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // Per-photo decisions (kept / deleted) — synced across the user's devices.
      match /photo_decisions/{photoId} {
        allow read, write: if isOwner(uid);
      }

      // Tracked app subscriptions (Netflix, Spotify, etc.) the user is paying for.
      match /subscriptions/{subscriptionId} {
        allow read, write: if isOwner(uid);
      }

      // App preferences (theme, sort order, etc.).
      match /settings/{docId} {
        allow read, write: if isOwner(uid);
      }

      // FCM tokens / device metadata for push.
      match /devices/{deviceId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
